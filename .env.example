# Public canonical domain for Explore India (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://exploreindia.in

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: set to "true" while validating events in GA4 DebugView
NEXT_PUBLIC_GA_DEBUG=false

# Google Search Console HTML meta tag verification code (token only, or full tag)
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional Bing Webmaster Tools verification token
NEXT_PUBLIC_BING_VERIFICATION=
